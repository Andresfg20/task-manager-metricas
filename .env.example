# ─────────────────────────────────────────────────────────────
# .env.example — local environment variables for Docker Compose
#
# Usage:  cp .env.example .env   then adjust .env for your machine.
# Never commit .env. These defaults are for local development only.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL, single database) ───────────────────
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager
POSTGRES_PORT=5432

# ── Backend (Spring Boot) ────────────────────────────────────
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://db:5432/taskmanager
JWT_SECRET=replace-with-a-long-random-local-only-string-of-32-plus-chars
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIMEZONE=America/Bogota

# ── Seeded administrator (see ADR-005) ───────────────────────
ADMIN_EMAIL=admin@taskmanager.local
ADMIN_PASSWORD=Admin12345

# ── Frontend (React SPA served by nginx) ─────────────────────
FRONTEND_PORT=3000
